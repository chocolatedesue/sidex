{
  "name": "sidex",
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/ensure-file-icon-theme.sh && bash scripts/ensure-pdfium-wasm.sh && node scripts/generate-extension-meta.js",
    "server:build": "cd sidexai/sidex-server && go build -tags fts5 -o sidex-server ./cmd/server",
    "setup:full": "bash scripts/setup-extensions.sh && node scripts/generate-extension-meta.js",
    "dev": "npm run setup && node --max-old-space-size=8192 node_modules/vite/bin/vite.js",
    "build": "npm run setup && node --max-old-space-size=12288 node_modules/vite/bin/vite.js build",
    "postbuild": "node scripts/postbuild.js",
    "preview": "vite preview",
    "tauri": "cross-env PATH=\"$PWD/scripts/bin:$PATH\" tauri",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,json}'",
    "rust:check": "cd src-tauri && cargo check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rust:fmt": "cd src-tauri && cargo fmt --all -- --check",
    "rust:fmt:fix": "cd src-tauri && cargo fmt --all",
    "smoke:startup": "node scripts/smoke-startup.mjs",
    "smoke:preview-md-diff": "node scripts/smoke-preview-and-md-diff.mjs",
    "smoke:remote-ssh": "node scripts/smoke-remote-ssh.mjs",
    "cli:install": "bash scripts/install-cli.sh",
    "smoke:cli-icons": "node scripts/smoke-cli-and-icons.mjs",
    "smoke:ux": "node scripts/smoke-ux-polish.mjs",
    "smoke:pdf": "bash scripts/ensure-pdfium-wasm.sh && node scripts/smoke-marketplace-pdf.mjs"
  },
  "dependencies": {
    "@embedpdf/snippet": "^2.15.1",
    "@microsoft/1ds-core-js": "^4.4.5",
    "@microsoft/1ds-post-js": "^4.4.5",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/iconv-lite-umd": "^0.7.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "katex": "^0.16.47",
    "monaco-editor": "^0.52.2",
    "tas-client": "^0.3.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@types/katex": "^0.16.8",
    "@types/trusted-types": "^2.0.7",
    "@webgpu/types": "^0.1.74",
    "@xterm/headless": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "jschardet": "^3.1.4",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vite-plugin-static-copy": "^2.2.0"
  }
}
